# TraceHunt .env.example
# Copy this file to .env and configure as needed

# Application Environment (development, testing, production)
ENVIRONMENT=development

# Database Configuration
# Default is SQLite in local data directory. For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/tracehunt
DATABASE_URL=sqlite:///./data/tracehunt.db

# Ingestion Settings
MAX_UPLOAD_SIZE_MB=50
INGESTION_BATCH_SIZE=500

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# API & Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=8501

# Report Generation
REPORTS_DIR=./reports
